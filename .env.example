# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# PostgreSQL connection string
# For Docker Compose, use the service name as host: postgresql://postgres:<password>@db:5432/hr_erp
# For local (non-Docker) development, use: postgresql://postgres:<password>@localhost:5432/hr_erp
DATABASE_URL=postgresql://postgres:root@db:5432/hr_erp

# JWT signing secret — use a long, random value in any real deployment
SECRET_KEY=change-this-to-a-long-random-secret

# JWT algorithm
ALGORITHM=HS256

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis connection string, used as the RQ job queue backend
# For Docker Compose, use the service name as host: redis://redis:6379
# For local (non-Docker) development, use: redis://localhost:6379
REDIS_URL=redis://redis:6379
